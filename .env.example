# Nimbus Hackathon - Environment Configuration
# Copy this file to .env:
#   cp .env.example .env

# Primary development database connection URL
DATABASE_URL=postgresql://postgres@localhost:5432/nimbus_db

# Isolated test database connection URL (used by automated tests)
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/nimbus_test_db

# Server ports (optional defaults)
BOOKING_PORT=8001
AIRLINE_PORT=8002
PAYMENT_PORT=8003
RESOLUTION_PORT=8000

# Admin Authentication Configuration
# Set secure Admin credentials for initial account bootstrap
ADMIN_EMAIL=admin@nimbus.local
ADMIN_PASSWORD=change_this_to_a_secure_admin_password_123!
INTERNAL_SERVICE_SECRET=change_to_a_secure_internal_service_secret_token
SESSION_COOKIE_NAME=nimbus_admin_session
SESSION_EXPIRE_HOURS=24
ENVIRONMENT=development
